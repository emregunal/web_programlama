@model Muayene
@{
    var hayvanlar = (SelectList)ViewData["Hayvanlar"]!;
    var veterinerler = (SelectList)ViewData["Veterinerler"]!;
    var hayvanMetni = hayvanlar.FirstOrDefault(x => x.Value == Model.HayvanId.ToString())?.Text;
}

<div asp-validation-summary="ModelOnly" class="text-danger"></div>
@if (!hayvanlar.Any())
{
    <div class="alert alert-warning">Muayene kaydı için önce hayvan kaydı oluşturulmalıdır.</div>
}
<div class="row">
    <div class="col-md-6 mb-3">
        <label asp-for="HayvanId" class="form-label"></label>
        @if (Model.RandevuId != null)
        {
            <div class="form-control-plaintext">@hayvanMetni</div>
            <input type="hidden" asp-for="HayvanId" />
            <input type="hidden" asp-for="RandevuId" />
        }
        else
        {
            <select asp-for="HayvanId" asp-items="hayvanlar" class="form-select">
                <option value="">-- Hayvan seçin --</option>
            </select>
        }
        <span asp-validation-for="HayvanId" class="text-danger"></span>
    </div>
    <div class="col-md-6 mb-3">
        <label asp-for="VeterinerId" class="form-label"></label>
        <select asp-for="VeterinerId" asp-items="veterinerler" class="form-select">
            <option value="">-- Veteriner seçin --</option>
        </select>
        <span asp-validation-for="VeterinerId" class="text-danger"></span>
    </div>
    @if (Model.RandevuId != null && ViewData["RandevuBilgi"] is string randevuBilgi)
    {
        <div class="col-12">
            <div class="alert alert-info">Bağlı randevu: @randevuBilgi</div>
        </div>
    }
    <div class="col-md-6 mb-3">
        <label asp-for="Tarih" class="form-label"></label>
        <input asp-for="Tarih" asp-format="{0:yyyy-MM-ddTHH:mm}" class="form-control" />
        <span asp-validation-for="Tarih" class="text-danger"></span>
    </div>
    <div class="col-md-6 mb-3">
        <label asp-for="Ucret" class="form-label"></label>
        <input asp-for="Ucret" class="form-control" inputmode="decimal" />
        <span asp-validation-for="Ucret" class="text-danger"></span>
    </div>
    <div class="col-12 mb-3">
        <label asp-for="Sikayet" class="form-label"></label>
        <textarea asp-for="Sikayet" class="form-control" rows="2"></textarea>
        <span asp-validation-for="Sikayet" class="text-danger"></span>
    </div>
    <div class="col-12 mb-3">
        <label asp-for="Teshis" class="form-label"></label>
        <textarea asp-for="Teshis" class="form-control" rows="2"></textarea>
        <span asp-validation-for="Teshis" class="text-danger"></span>
    </div>
    <div class="col-12 mb-3">
        <label asp-for="Tedavi" class="form-label"></label>
        <textarea asp-for="Tedavi" class="form-control" rows="2"></textarea>
        <span asp-validation-for="Tedavi" class="text-danger"></span>
    </div>
    <div class="col-12 mb-3">
        <label asp-for="Notlar" class="form-label"></label>
        <textarea asp-for="Notlar" class="form-control" rows="3"></textarea>
        <span asp-validation-for="Notlar" class="text-danger"></span>
    </div>
</div>
