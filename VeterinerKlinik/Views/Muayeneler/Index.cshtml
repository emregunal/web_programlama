@model IEnumerable<MuayeneListeOgesi>
@{
    ViewData["Title"] = "Muayeneler";
    var arama = ViewData["Arama"] as string;
    var baslangic = ViewData["Baslangic"] as string;
    var bitis = ViewData["Bitis"] as string;
    var filtreHata = ViewData["FiltreHata"] as string;
    var veterinerler = (SelectList)ViewData["Veterinerler"]!;
    var odemeDurumlari = (List<SelectListItem>)ViewData["OdemeDurumlari"]!;
    var filtreVar = Context.Request.Query.Any(q => !string.IsNullOrEmpty(q.Value));
}

<div class="sayfa-baslik">
    <div>
        <h1>Muayeneler</h1>
        <p class="sayfa-aciklama">Muayene kayıtları, teşhis ve tedaviler ile ödeme durumları.</p>
    </div>
    <div class="sayfa-eylemler">
        <a asp-action="Create" class="btn btn-primary">
            <i class="bi bi-plus-lg" aria-hidden="true"></i> Yeni Muayene
        </a>
    </div>
</div>

<partial name="_Bildirim" />

@if (filtreHata != null)
{
    <div class="alert alert-warning" role="alert">
        <i class="bi bi-exclamation-triangle-fill" aria-hidden="true"></i>
        <div>@filtreHata</div>
    </div>
}

<form method="get" asp-action="Index" class="filtre row g-2 align-items-end" role="search">
    <div class="col-12 col-md-6 col-xl">
        <label for="filtreArama" class="form-label">Arama</label>
        <div class="arama-kutusu">
            <i class="bi bi-search" aria-hidden="true"></i>
            <input type="search" id="filtreArama" name="arama" value="@arama" class="form-control"
                   placeholder="Hayvan, sahip veya teşhis ara" />
        </div>
    </div>
    <div class="col-sm-6 col-md-3 col-xl-2">
        <label for="filtreVeteriner" class="form-label">Veteriner</label>
        <select id="filtreVeteriner" name="veterinerId" asp-items="veterinerler" class="form-select">
            <option value="">Tümü</option>
        </select>
    </div>
    <div class="col-sm-6 col-md-3 col-xl-2">
        <label for="filtreDurum" class="form-label">Ödeme durumu</label>
        <select id="filtreDurum" name="odemeDurumu" asp-items="odemeDurumlari" class="form-select">
            <option value="">Tümü</option>
        </select>
    </div>
    <div class="col-6 col-md-3 col-xl-2">
        <label for="filtreBaslangic" class="form-label">Başlangıç</label>
        <input type="date" id="filtreBaslangic" name="baslangic" value="@baslangic" class="form-control" />
    </div>
    <div class="col-6 col-md-3 col-xl-2">
        <label for="filtreBitis" class="form-label">Bitiş</label>
        <input type="date" id="filtreBitis" name="bitis" value="@bitis" class="form-control" />
    </div>
    <div class="col-12 col-md-6 col-xl-auto d-flex gap-2 justify-content-end">
        @if (filtreVar)
        {
            <a asp-action="Index" class="btn btn-outline-secondary">Temizle</a>
        }
        <button type="submit" class="btn btn-outline-primary"><i class="bi bi-funnel" aria-hidden="true"></i> Filtrele</button>
    </div>
</form>

<div class="tablo-kart">
    <table class="table align-middle">
        <thead>
            <tr>
                <th scope="col">Tarih</th>
                <th scope="col">Hayvan</th>
                <th scope="col">Sahip</th>
                <th scope="col">Veteriner</th>
                <th scope="col">Teşhis</th>
                <th scope="col" class="text-end">Toplam</th>
                <th scope="col" class="text-end">Kalan</th>
                <th scope="col">Durum</th>
                <th scope="col" class="text-end"><span class="visually-hidden">İşlemler</span></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var m in Model)
            {
                <tr>
                    <td class="text-nowrap">
                        @m.Tarih.ToString("dd.MM.yyyy")
                        <span class="hucre-alt">@m.Tarih.ToString("HH:mm")</span>
                    </td>
                    <td>
                        <a asp-action="Details" asp-route-id="@m.Id" class="hucre-ana">@m.HayvanAdi</a>
                        <span class="hucre-alt">@m.HayvanTuru.GetDisplayName()</span>
                    </td>
                    <td><a asp-controller="Sahipler" asp-action="Details" asp-route-id="@m.SahipId">@m.SahipAdSoyad</a></td>
                    <td>@m.VeterinerAdSoyad</td>
                    <td>@m.Teshis</td>
                    <td class="text-end tutar">@m.GenelToplam.TL()</td>
                    <td class="text-end tutar">@m.KalanBorc.TL()</td>
                    <td><partial name="_OdemeDurumuRozeti" model="m.OdemeDurumu" /></td>
                    <td>
                        <div class="islemler">
                            <a asp-action="Details" asp-route-id="@m.Id" class="btn btn-ikon" title="Detay" aria-label="Muayene #@m.Id detayı"><i class="bi bi-eye" aria-hidden="true"></i></a>
                            <a asp-action="Edit" asp-route-id="@m.Id" class="btn btn-ikon" title="Düzenle" aria-label="Muayene #@m.Id düzenle"><i class="bi bi-pencil-square" aria-hidden="true"></i></a>
                            <a asp-action="Delete" asp-route-id="@m.Id" class="btn btn-ikon tehlike" title="Sil" aria-label="Muayene #@m.Id sil"><i class="bi bi-trash3" aria-hidden="true"></i></a>
                        </div>
                    </td>
                </tr>
            }
            @if (!Model.Any())
            {
                <tr>
                    <td colspan="9">
                        <div class="bos-durum">
                            <span class="bos-durum-ikon" aria-hidden="true"><i class="bi bi-clipboard2-pulse"></i></span>
                            @if (filtreVar)
                            {
                                <div class="bos-durum-baslik">Filtrelere uyan muayene bulunamadı.</div>
                                <p>Filtreleri değiştirerek tekrar deneyin.</p>
                                <a asp-action="Index" class="btn btn-outline-secondary btn-sm">Filtreleri temizle</a>
                            }
                            else
                            {
                                <div class="bos-durum-baslik">Henüz muayene kaydı yok.</div>
                                <p>İlk muayene kaydını oluşturarak başlayın.</p>
                                <a asp-action="Create" class="btn btn-primary btn-sm"><i class="bi bi-plus-lg" aria-hidden="true"></i> Yeni Muayene</a>
                            }
                        </div>
                    </td>
                </tr>
            }
        </tbody>
        @if (Model.Any())
        {
            <tfoot>
                <tr>
                    <th scope="row" colspan="5">@Model.Count() muayene</th>
                    <th class="text-end tutar">@Model.Sum(m => m.GenelToplam).TL()</th>
                    <th class="text-end tutar">@Model.Sum(m => m.KalanBorc).TL()</th>
                    <th colspan="2"></th>
                </tr>
            </tfoot>
        }
    </table>
</div>
