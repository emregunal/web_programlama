@model IEnumerable<MuayeneListeOgesi>
@{
    ViewData["Title"] = "Muayeneler";
    var arama = ViewData["Arama"] as string;
    var baslangic = ViewData["Baslangic"] as string;
    var bitis = ViewData["Bitis"] as string;
    var filtreHata = ViewData["FiltreHata"] as string;
    var veterinerler = (SelectList)ViewData["Veterinerler"]!;
    var odemeDurumlari = (List<SelectListItem>)ViewData["OdemeDurumlari"]!;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="mb-0">Muayeneler</h1>
    <a asp-action="Create" class="btn btn-primary">Yeni Muayene</a>
</div>

<partial name="_Bildirim" />

@if (filtreHata != null)
{
    <div class="alert alert-warning">@filtreHata</div>
}

<form method="get" asp-action="Index" class="row g-2 mb-3">
    <div class="col-sm-6 col-md-3">
        <input type="text" name="arama" value="@arama" class="form-control" aria-label="Arama"
               placeholder="Hayvan, sahip veya teşhis ara" />
    </div>
    <div class="col-sm-6 col-md-2">
        <select name="veterinerId" asp-items="veterinerler" class="form-select" aria-label="Veteriner">
            <option value="">Tüm veterinerler</option>
        </select>
    </div>
    <div class="col-sm-6 col-md-2">
        <select name="odemeDurumu" asp-items="odemeDurumlari" class="form-select" aria-label="Ödeme durumu">
            <option value="">Tüm ödeme durumları</option>
        </select>
    </div>
    <div class="col-sm-6 col-md-2">
        <input type="date" name="baslangic" value="@baslangic" class="form-control" aria-label="Başlangıç tarihi" />
    </div>
    <div class="col-sm-6 col-md-2">
        <input type="date" name="bitis" value="@bitis" class="form-control" aria-label="Bitiş tarihi" />
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-outline-primary">Ara</button>
        <a asp-action="Index" class="btn btn-outline-secondary">Temizle</a>
    </div>
</form>

<table class="table table-striped align-middle">
    <thead>
        <tr>
            <th>Tarih</th>
            <th>Hayvan</th>
            <th>Sahip</th>
            <th>Veteriner</th>
            <th>Teşhis</th>
            <th class="text-end">Toplam</th>
            <th class="text-end">Kalan</th>
            <th>Durum</th>
            <th>İşlemler</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var m in Model)
        {
            <tr>
                <td>@m.Tarih.ToString("dd.MM.yyyy HH:mm")</td>
                <td>@m.HayvanAdi (@m.HayvanTuru.GetDisplayName())</td>
                <td><a asp-controller="Sahipler" asp-action="Details" asp-route-id="@m.SahipId">@m.SahipAdSoyad</a></td>
                <td>@m.VeterinerAdSoyad</td>
                <td>@m.Teshis</td>
                <td class="text-end">@m.GenelToplam.TL()</td>
                <td class="text-end">@m.KalanBorc.TL()</td>
                <td><partial name="_OdemeDurumuRozeti" model="m.OdemeDurumu" /></td>
                <td>
                    <a asp-action="Details" asp-route-id="@m.Id" class="btn btn-sm btn-outline-info">Detay</a>
                    <a asp-action="Edit" asp-route-id="@m.Id" class="btn btn-sm btn-outline-primary">Düzenle</a>
                    <a asp-action="Delete" asp-route-id="@m.Id" class="btn btn-sm btn-outline-danger">Sil</a>
                </td>
            </tr>
        }
        @if (!Model.Any())
        {
            <tr><td colspan="9" class="text-center text-muted">Kayıt bulunamadı.</td></tr>
        }
    </tbody>
    <tfoot>
        <tr>
            <th colspan="5">@Model.Count() muayene</th>
            <th class="text-end">@Model.Sum(m => m.GenelToplam).TL()</th>
            <th class="text-end">@Model.Sum(m => m.KalanBorc).TL()</th>
            <th colspan="2"></th>
        </tr>
    </tfoot>
</table>
