@model KullaniciFormModel
@{
    var veterinerler = (SelectList)ViewData["Veterinerler"]!;
    var yeniKayit = Model.Id == 0;
}

<div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
<div class="row">
    <div class="col-md-6 mb-3">
        <label asp-for="AdSoyad" class="form-label"></label>
        <input asp-for="AdSoyad" class="form-control" />
        <span asp-validation-for="AdSoyad" class="text-danger"></span>
    </div>
    <div class="col-md-6 mb-3">
        <label asp-for="KullaniciAdi" class="form-label"></label>
        <input asp-for="KullaniciAdi" class="form-control" autocomplete="off" />
        <span asp-validation-for="KullaniciAdi" class="text-danger"></span>
    </div>
    <div class="col-md-6 mb-3">
        <label asp-for="Rol" class="form-label"></label>
        <select asp-for="Rol" asp-items="Html.GetEnumSelectList<KullaniciRolu>()" class="form-select"></select>
        <span asp-validation-for="Rol" class="text-danger"></span>
    </div>
    <div class="col-md-6 mb-3">
        <label asp-for="VeterinerId" class="form-label"></label>
        <select asp-for="VeterinerId" asp-items="veterinerler" class="form-select">
            <option value="">-- Veteriner seçin --</option>
        </select>
        <div class="form-text">Yalnızca Veteriner rolü için gereklidir.</div>
        <span asp-validation-for="VeterinerId" class="text-danger"></span>
    </div>
    <div class="col-md-6 mb-3">
        <label asp-for="YeniParola" class="form-label">@(yeniKayit ? "Parola" : "Yeni parola")</label>
        <input asp-for="YeniParola" class="form-control" autocomplete="new-password" />
        <div class="form-text">En az 8 karakter, harf ve rakam içermelidir.</div>
        <span asp-validation-for="YeniParola" class="text-danger"></span>
    </div>
    <div class="col-md-6 mb-3">
        <label asp-for="YeniParolaTekrar" class="form-label"></label>
        <input asp-for="YeniParolaTekrar" class="form-control" autocomplete="new-password" />
        <span asp-validation-for="YeniParolaTekrar" class="text-danger"></span>
    </div>
    <div class="col-12">
        <div class="form-check">
            <input asp-for="Aktif" class="form-check-input" />
            <label asp-for="Aktif" class="form-check-label"></label>
        </div>
    </div>
</div>
