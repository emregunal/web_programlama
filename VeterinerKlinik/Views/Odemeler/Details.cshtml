@model Odeme
@{
    ViewData["Title"] = "Makbuz #" + Model.Id;
    var muayene = Model.Muayene;
}

<div class="d-print-none">
    <div class="belge-eylemler">
        <a asp-action="Index" class="btn btn-secondary"><i class="bi bi-arrow-left" aria-hidden="true"></i> Ödemeler</a>
        @if (Model.MuayeneId != null)
        {
            <a asp-controller="Muayeneler" asp-action="Details" asp-route-id="@Model.MuayeneId" class="btn btn-secondary"><i class="bi bi-clipboard2-pulse" aria-hidden="true"></i> Muayeneye Dön</a>
        }
        <button type="button" class="btn btn-primary" onclick="window.print()"><i class="bi bi-printer" aria-hidden="true"></i> Yazdır</button>
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-primary"><i class="bi bi-pencil-square" aria-hidden="true"></i> Düzenle</a>
        <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-outline-danger"><i class="bi bi-trash3" aria-hidden="true"></i> Sil</a>
    </div>
    <partial name="_Bildirim" />
</div>

<article class="belge">
    <header class="belge-ust">
        <div class="belge-marka">
            <span class="marka-logo"><partial name="_Pati" /></span>
            <div>
                <h1>Veteriner Kliniği</h1>
                <div class="belge-tur">TAHSİLAT MAKBUZU</div>
            </div>
        </div>
        <dl class="belge-meta">
            <div><dt>Makbuz No:</dt><dd>@Model.Id</dd></div>
            <div><dt>Tarih:</dt><dd>@Model.Tarih.ToString("dd.MM.yyyy HH:mm")</dd></div>
        </dl>
    </header>

    <div class="row g-4 mb-4 align-items-center">
        <div class="col-md-7">
            <dl class="bilgi-listesi">
                <div><dt>Sahip</dt><dd class="fw-bold">@Model.Sahip!.AdSoyad</dd></div>
                <div><dt>Telefon</dt><dd>@Model.Sahip.Telefon</dd></div>
                <div><dt>@Html.DisplayNameFor(m => m.MuayeneId)</dt><dd>@(muayene?.KisaTanim ?? "—")</dd></div>
                <div><dt>@Html.DisplayNameFor(m => m.Yontem)</dt><dd>@Model.Yontem.GetDisplayName()</dd></div>
                @if (!string.IsNullOrWhiteSpace(Model.Aciklama))
                {
                    <div><dt>@Html.DisplayNameFor(m => m.Aciklama)</dt><dd>@Model.Aciklama</dd></div>
                }
            </dl>
        </div>
        <div class="col-md-5">
            <div class="belge-taraf text-md-end">
                <h2 class="belge-bolum-baslik">@Html.DisplayNameFor(m => m.Tutar)</h2>
                <div class="belge-buyuk-tutar">@Model.Tutar.TL()</div>
            </div>
        </div>
    </div>

    @if (muayene != null)
    {
        <h2 class="belge-bolum-baslik">Güncel hesap durumu (@DateTime.Now.ToString("dd.MM.yyyy HH:mm") itibarıyla)</h2>
        <dl class="toplam-tablosu belge-ozet">
            <div><dt>Muayene toplamı</dt><dd>@muayene.GenelToplam.TL()</dd></div>
            <div><dt>Toplam ödenen</dt><dd>@muayene.OdenenToplam.TL()</dd></div>
            <div class="ayrac"><dt>Kalan borç</dt><dd>@muayene.KalanBorc.TL()</dd></div>
        </dl>
    }

    <div class="imza">
        <div>
            <div class="text-secondary">Teslim Alan</div>
            <div class="imza-cizgi"></div>
        </div>
    </div>
</article>
