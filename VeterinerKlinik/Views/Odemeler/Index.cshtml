@model IEnumerable<OdemeListeOgesi>
@{
    ViewData["Title"] = "Ödemeler";
    var arama = ViewData["Arama"] as string;
    var baslangic = ViewData["Baslangic"] as string;
    var bitis = ViewData["Bitis"] as string;
    var filtreHata = ViewData["FiltreHata"] as string;
    var yontemler = (List<SelectListItem>)ViewData["Yontemler"]!;
    var toplam = Model.Sum(o => o.Tutar);
    var filtreVar = Context.Request.Query.Any(q => !string.IsNullOrEmpty(q.Value));
}

<div class="sayfa-baslik">
    <div>
        <h1>Ödemeler</h1>
        <p class="sayfa-aciklama">Tahsilatlar, makbuzlar ve yönteme göre dağılım.</p>
    </div>
    <div class="sayfa-eylemler">
        <a asp-action="Create" class="btn btn-primary">
            <i class="bi bi-plus-lg" aria-hidden="true"></i> Yeni Ödeme
        </a>
    </div>
</div>

<partial name="_Bildirim" />

@if (filtreHata != null)
{
    <div class="alert alert-warning" role="alert">
        <i class="bi bi-exclamation-triangle-fill" aria-hidden="true"></i>
        <div>@filtreHata</div>
    </div>
}

<div class="ozet-grid">
    @foreach (var y in Enum.GetValues<OdemeYontemi>())
    {
        var ikon = y switch
        {
            OdemeYontemi.Nakit => "bi-cash-stack",
            OdemeYontemi.KrediKarti => "bi-credit-card",
            _ => "bi-bank"
        };
        <div class="ozet-kart">
            <span class="ozet-ikon" aria-hidden="true"><i class="bi @ikon"></i></span>
            <div>
                <div class="ozet-etiket">@y.GetDisplayName()</div>
                <div class="ozet-deger">@Model.Where(o => o.Yontem == y).Sum(o => o.Tutar).TL()</div>
            </div>
        </div>
    }
    <div class="ozet-kart">
        <span class="ozet-ikon vurgu" aria-hidden="true"><i class="bi bi-wallet2"></i></span>
        <div>
            <div class="ozet-etiket">Toplam</div>
            <div class="ozet-deger">@toplam.TL()</div>
        </div>
    </div>
</div>

<form method="get" asp-action="Index" class="filtre row g-2 align-items-end" role="search">
    <div class="col-12 col-xl">
        <label for="filtreArama" class="form-label">Arama</label>
        <div class="arama-kutusu">
            <i class="bi bi-search" aria-hidden="true"></i>
            <input type="search" id="filtreArama" name="arama" value="@arama" class="form-control"
                   placeholder="Sahip, hayvan veya açıklama ara" />
        </div>
    </div>
    <div class="col-sm-4 col-xl-2">
        <label for="filtreYontem" class="form-label">Yöntem</label>
        <select id="filtreYontem" name="yontem" asp-items="yontemler" class="form-select">
            <option value="">Tümü</option>
        </select>
    </div>
    <div class="col-6 col-sm-4 col-xl-2">
        <label for="filtreBaslangic" class="form-label">Başlangıç</label>
        <input type="date" id="filtreBaslangic" name="baslangic" value="@baslangic" class="form-control" />
    </div>
    <div class="col-6 col-sm-4 col-xl-2">
        <label for="filtreBitis" class="form-label">Bitiş</label>
        <input type="date" id="filtreBitis" name="bitis" value="@bitis" class="form-control" />
    </div>
    <div class="col-12 col-xl-auto d-flex gap-2 justify-content-end">
        @if (filtreVar)
        {
            <a asp-action="Index" class="btn btn-outline-secondary">Temizle</a>
        }
        <button type="submit" class="btn btn-outline-primary"><i class="bi bi-funnel" aria-hidden="true"></i> Filtrele</button>
    </div>
</form>

<div class="tablo-kart">
    <table class="table align-middle">
        <thead>
            <tr>
                <th scope="col">Tarih</th>
                <th scope="col">Sahip</th>
                <th scope="col">Muayene</th>
                <th scope="col">Yöntem</th>
                <th scope="col" class="text-end">Tutar</th>
                <th scope="col">Açıklama</th>
                <th scope="col" class="text-end"><span class="visually-hidden">İşlemler</span></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var o in Model)
            {
                <tr>
                    <td class="text-nowrap">
                        @o.Tarih.ToString("dd.MM.yyyy")
                        <span class="hucre-alt">@o.Tarih.ToString("HH:mm")</span>
                    </td>
                    <td><a asp-controller="Sahipler" asp-action="Details" asp-route-id="@o.SahipId">@o.SahipAdSoyad</a></td>
                    <td>
                        @if (o.MuayeneId != null)
                        {
                            <a asp-controller="Muayeneler" asp-action="Details" asp-route-id="@o.MuayeneId">#@o.MuayeneId</a>
                            <span class="hucre-alt">@o.HayvanAdi</span>
                        }
                        else
                        {
                            <span>—</span>
                        }
                    </td>
                    <td>@o.Yontem.GetDisplayName()</td>
                    <td class="text-end tutar fw-bold">@o.Tutar.TL()</td>
                    <td>@o.Aciklama</td>
                    <td>
                        <div class="islemler">
                            <a asp-action="Details" asp-route-id="@o.Id" class="btn btn-ikon" title="Makbuz" aria-label="Makbuz #@o.Id"><i class="bi bi-receipt" aria-hidden="true"></i></a>
                            <a asp-action="Edit" asp-route-id="@o.Id" class="btn btn-ikon" title="Düzenle" aria-label="Ödeme #@o.Id düzenle"><i class="bi bi-pencil-square" aria-hidden="true"></i></a>
                            <a asp-action="Delete" asp-route-id="@o.Id" class="btn btn-ikon tehlike" title="Sil" aria-label="Ödeme #@o.Id sil"><i class="bi bi-trash3" aria-hidden="true"></i></a>
                        </div>
                    </td>
                </tr>
            }
            @if (!Model.Any())
            {
                <tr>
                    <td colspan="7">
                        <div class="bos-durum">
                            <span class="bos-durum-ikon" aria-hidden="true"><i class="bi bi-wallet2"></i></span>
                            @if (filtreVar)
                            {
                                <div class="bos-durum-baslik">Filtrelere uyan ödeme bulunamadı.</div>
                                <p>Filtreleri değiştirerek tekrar deneyin.</p>
                                <a asp-action="Index" class="btn btn-outline-secondary btn-sm">Filtreleri temizle</a>
                            }
                            else
                            {
                                <div class="bos-durum-baslik">Henüz ödeme alınmadı.</div>
                                <p>Muayene detayından veya buradan ödeme alabilirsiniz.</p>
                                <a asp-action="Create" class="btn btn-primary btn-sm"><i class="bi bi-plus-lg" aria-hidden="true"></i> Yeni Ödeme</a>
                            }
                        </div>
                    </td>
                </tr>
            }
        </tbody>
        @if (Model.Any())
        {
            <tfoot>
                <tr>
                    <th scope="row" colspan="4">@Model.Count() ödeme</th>
                    <th class="text-end tutar">@toplam.TL()</th>
                    <th colspan="2"></th>
                </tr>
            </tfoot>
        }
    </table>
</div>
