@model IEnumerable<OdemeListeOgesi>
@{
    ViewData["Title"] = "Ödemeler";
    var arama = ViewData["Arama"] as string;
    var baslangic = ViewData["Baslangic"] as string;
    var bitis = ViewData["Bitis"] as string;
    var filtreHata = ViewData["FiltreHata"] as string;
    var yontemler = (List<SelectListItem>)ViewData["Yontemler"]!;
    var toplam = Model.Sum(o => o.Tutar);
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="mb-0">Ödemeler</h1>
    <a asp-action="Create" class="btn btn-primary">Yeni Ödeme</a>
</div>

<partial name="_Bildirim" />

@if (filtreHata != null)
{
    <div class="alert alert-warning">@filtreHata</div>
}

<form method="get" asp-action="Index" class="row g-2 mb-3">
    <div class="col-sm-6 col-md-3">
        <input type="text" name="arama" value="@arama" class="form-control" aria-label="Arama"
               placeholder="Sahip, hayvan veya açıklama ara" />
    </div>
    <div class="col-sm-6 col-md-2">
        <select name="yontem" asp-items="yontemler" class="form-select" aria-label="Ödeme yöntemi">
            <option value="">Tüm yöntemler</option>
        </select>
    </div>
    <div class="col-sm-6 col-md-2">
        <input type="date" name="baslangic" value="@baslangic" class="form-control" aria-label="Başlangıç tarihi" />
    </div>
    <div class="col-sm-6 col-md-2">
        <input type="date" name="bitis" value="@bitis" class="form-control" aria-label="Bitiş tarihi" />
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-outline-primary">Ara</button>
        <a asp-action="Index" class="btn btn-outline-secondary">Temizle</a>
    </div>
</form>

<div class="row g-2 mb-3">
    @foreach (var y in Enum.GetValues<OdemeYontemi>())
    {
        <div class="col-6 col-md-3">
            <div class="border rounded p-2">
                <div class="text-muted small">@y.GetDisplayName()</div>
                <div class="fw-bold">@Model.Where(o => o.Yontem == y).Sum(o => o.Tutar).TL()</div>
            </div>
        </div>
    }
    <div class="col-6 col-md-3">
        <div class="border rounded p-2">
            <div class="text-muted small">Toplam</div>
            <div class="fw-bold">@toplam.TL()</div>
        </div>
    </div>
</div>

<table class="table table-striped align-middle">
    <thead>
        <tr>
            <th>Tarih</th>
            <th>Sahip</th>
            <th>Muayene</th>
            <th>Yöntem</th>
            <th class="text-end">Tutar</th>
            <th>Açıklama</th>
            <th>İşlemler</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var o in Model)
        {
            <tr>
                <td>@o.Tarih.ToString("dd.MM.yyyy HH:mm")</td>
                <td><a asp-controller="Sahipler" asp-action="Details" asp-route-id="@o.SahipId">@o.SahipAdSoyad</a></td>
                <td>
                    @if (o.MuayeneId != null)
                    {
                        <a asp-controller="Muayeneler" asp-action="Details" asp-route-id="@o.MuayeneId">#@o.MuayeneId - @o.HayvanAdi</a>
                    }
                    else
                    {
                        <span>—</span>
                    }
                </td>
                <td>@o.Yontem.GetDisplayName()</td>
                <td class="text-end">@o.Tutar.TL()</td>
                <td>@o.Aciklama</td>
                <td>
                    <a asp-action="Details" asp-route-id="@o.Id" class="btn btn-sm btn-outline-secondary">Makbuz</a>
                    <a asp-action="Edit" asp-route-id="@o.Id" class="btn btn-sm btn-outline-primary">Düzenle</a>
                    <a asp-action="Delete" asp-route-id="@o.Id" class="btn btn-sm btn-outline-danger">Sil</a>
                </td>
            </tr>
        }
        @if (!Model.Any())
        {
            <tr><td colspan="7" class="text-center text-muted">Kayıt bulunamadı.</td></tr>
        }
    </tbody>
    <tfoot>
        <tr>
            <th colspan="4">@Model.Count() ödeme</th>
            <th class="text-end">@toplam.TL()</th>
            <th colspan="2"></th>
        </tr>
    </tfoot>
</table>
