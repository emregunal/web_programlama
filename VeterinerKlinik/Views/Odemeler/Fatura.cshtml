@model Muayene
@{
    var faturaNo = $"F{Model.Id:D6}";
    ViewData["Title"] = "Fatura " + faturaNo;
    var hayvan = Model.Hayvan!;
    var sahip = hayvan.Sahip!;
    var sira = 1;
}

<div class="belge-eylemler d-print-none">
    <a asp-controller="Muayeneler" asp-action="Details" asp-route-id="@Model.Id" class="btn btn-secondary"><i class="bi bi-arrow-left" aria-hidden="true"></i> Muayeneye Dön</a>
    <button type="button" class="btn btn-primary" onclick="window.print()"><i class="bi bi-printer" aria-hidden="true"></i> Yazdır</button>
    @if (Model.KalanBorc > 0)
    {
        <a asp-action="Create" asp-route-muayeneId="@Model.Id" class="btn btn-success"><i class="bi bi-cash-coin" aria-hidden="true"></i> Ödeme Al</a>
    }
</div>

<article class="belge">
    <header class="belge-ust">
        <div class="belge-marka">
            <span class="marka-logo"><partial name="_Pati" /></span>
            <div>
                <h1>Veteriner Kliniği</h1>
                <div class="belge-tur">FATURA</div>
            </div>
        </div>
        <dl class="belge-meta">
            <div><dt>Fatura No:</dt><dd>@faturaNo</dd></div>
            <div><dt>Muayene Tarihi:</dt><dd>@Model.Tarih.ToString("dd.MM.yyyy")</dd></div>
            <div><dt>Düzenlenme Tarihi:</dt><dd>@DateTime.Now.ToString("dd.MM.yyyy HH:mm")</dd></div>
        </dl>
    </header>

    <div class="row g-3 mb-4">
        <div class="col-sm-6">
            <div class="belge-taraf">
                <h2 class="belge-bolum-baslik">Sayın</h2>
                <div><strong>@sahip.AdSoyad</strong></div>
                <div>Telefon: @sahip.Telefon</div>
                @if (!string.IsNullOrWhiteSpace(sahip.Adres))
                {
                    <div>Adres: @sahip.Adres</div>
                }
            </div>
        </div>
        <div class="col-sm-6">
            <div class="belge-taraf">
                <h2 class="belge-bolum-baslik">Hasta</h2>
                <div><strong>@hayvan.Ad</strong> (@hayvan.Tur.GetDisplayName())</div>
                <div>Veteriner: @Model.Veteriner!.AdSoyad</div>
            </div>
        </div>
    </div>

    <div class="belge-tablo">
        <table class="table align-middle">
            <thead>
                <tr>
                    <th scope="col">#</th>
                    <th scope="col">Açıklama</th>
                    <th scope="col">Miktar</th>
                    <th scope="col" class="text-end">Birim Fiyat</th>
                    <th scope="col" class="text-end">Tutar</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td>1</td>
                    <td class="hucre-ana">Muayene ücreti</td>
                    <td>1</td>
                    <td class="text-end tutar">@Model.Ucret.TL()</td>
                    <td class="text-end tutar">@Model.Ucret.TL()</td>
                </tr>
                @foreach (var k in Model.ReceteKalemleri)
                {
                    sira++;
                    <tr>
                        <td>@sira</td>
                        <td class="hucre-ana">@k.Ilac!.AdVeForm</td>
                        <td class="text-nowrap">@k.Adet @k.Ilac.Birim</td>
                        <td class="text-end tutar">@k.BirimFiyat.TL()</td>
                        <td class="text-end tutar">@k.Tutar.TL()</td>
                    </tr>
                }
            </tbody>
            <tfoot>
                <tr>
                    <th scope="row" colspan="4">Genel Toplam</th>
                    <th class="text-end tutar">@Model.GenelToplam.TL()</th>
                </tr>
            </tfoot>
        </table>
    </div>

    <div class="row g-4 mt-1 align-items-start">
        <div class="col-md-6">
            @if (Model.Odemeler.Any())
            {
                <h2 class="belge-bolum-baslik">Ödemeler</h2>
                <div class="belge-tablo">
                    <table class="table table-sm">
                        <thead>
                            <tr>
                                <th scope="col">Tarih</th>
                                <th scope="col">Yöntem</th>
                                <th scope="col" class="text-end">Tutar</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var o in Model.Odemeler)
                            {
                                <tr>
                                    <td>@o.Tarih.ToString("dd.MM.yyyy")</td>
                                    <td>@o.Yontem.GetDisplayName()</td>
                                    <td class="text-end tutar">@o.Tutar.TL()</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
        <div class="col-md-6 d-flex justify-content-md-end">
            <dl class="toplam-tablosu belge-ozet">
                <div><dt>Genel toplam</dt><dd>@Model.GenelToplam.TL()</dd></div>
                <div><dt>Ödenen</dt><dd>@Model.OdenenToplam.TL()</dd></div>
                <div class="ayrac"><dt>Kalan borç</dt><dd>@Model.KalanBorc.TL()</dd></div>
                <div><dt>Durum</dt><dd><partial name="_OdemeDurumuRozeti" model="Model.OdemeDurumu" /></dd></div>
            </dl>
        </div>
    </div>
</article>
