@{
    var aktifController = ViewContext.RouteData.Values["controller"] as string;
    var menu = new (string Controller, string Baslik, string Ikon)[]
    {
        ("Home", "Ana Sayfa", "bi-grid-1x2"),
        ("Sahipler", "Sahipler", "bi-people"),
        ("Hayvanlar", "Hayvanlar", "pati"),
        ("Randevular", "Randevular", "bi-calendar2-week"),
        ("Muayeneler", "Muayeneler", "bi-clipboard2-pulse"),
        ("Ilaclar", "İlaçlar", "bi-capsule"),
        ("Asilar", "Aşılar", "bi-shield-plus"),
        ("Odemeler", "Ödemeler", "bi-wallet2"),
        ("Kullanicilar", "Kullanıcılar", "bi-person-gear")
    };
    var gorunenMenu = menu.Where(m => YetkiKurallari.OkuyabilirMi(User, m.Controller)).ToList();
    var girisli = User.Identity?.IsAuthenticated == true;
    var adSoyad = User.AdSoyad();
    var basHarfler = string.Concat(adSoyad.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(k => char.ToUpper(k[0])));
}
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#0b3b37" />
    <title>@ViewData["Title"] - Veteriner Kliniği</title>
    <script type="importmap"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Nunito+Sans:opsz,wght@6..12,400;6..12,600;6..12,700;6..12,800&family=Varela+Round&display=swap" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/lib/bootstrap-icons/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/hesap.css" asp-append-version="true" />
</head>
<body>
    <a class="atla-link visually-hidden-focusable" href="#icerik">İçeriğe geç</a>

    <div class="uygulama">
        <aside class="kenar-cubuk offcanvas-lg offcanvas-start d-print-none" id="kenarCubuk" tabindex="-1" aria-label="Ana menü">
            <div class="offcanvas-header d-lg-none">
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="offcanvas" data-bs-target="#kenarCubuk" aria-label="Menüyü kapat"></button>
            </div>
            <div class="offcanvas-body">
                <a class="marka" asp-controller="Home" asp-action="Index">
                    <span class="marka-logo"><partial name="_Pati" /></span>
                    <span class="marka-metin">
                        <span class="marka-ad">Veteriner Kliniği</span>
                        <span class="marka-alt">Yönetim Paneli</span>
                    </span>
                </a>

                <nav aria-labelledby="menuBaslik">
                    <h2 class="menu-baslik" id="menuBaslik">Menü</h2>
                    <ul class="menu">
                        @foreach (var m in gorunenMenu)
                        {
                            var aktif = string.Equals(aktifController, m.Controller, StringComparison.OrdinalIgnoreCase);
                            <li>
                                <a class="menu-link @(aktif ? "active" : null)" aria-current="@(aktif ? "page" : null)"
                                   asp-controller="@m.Controller" asp-action="Index">
                                    @if (m.Ikon == "pati")
                                    {
                                        <partial name="_Pati" />
                                    }
                                    else
                                    {
                                        <i class="bi @m.Ikon" aria-hidden="true"></i>
                                    }
                                    <span>@m.Baslik</span>
                                </a>
                            </li>
                        }
                    </ul>
                </nav>

                <div class="kenar-alt">
                    @if (girisli)
                    {
                        <div class="kullanici-kutusu">
                            <span class="kullanici-avatar" aria-hidden="true">@basHarfler</span>
                            <div class="kullanici-bilgi">
                                <span class="kullanici-ad">@adSoyad</span>
                                <span class="kullanici-rol">@User.RolAdi()</span>
                            </div>
                            <form asp-controller="Hesap" asp-action="Cikis" method="post" class="kullanici-cikis">
                                <button type="submit" class="btn-cikis" title="Çıkış" aria-label="Çıkış yap">
                                    <i class="bi bi-box-arrow-right" aria-hidden="true"></i> Çıkış
                                </button>
                            </form>
                        </div>
                    }
                    <div class="kenar-telif">&copy; @DateTime.Now.Year Veteriner Kliniği</div>
                </div>
            </div>
        </aside>

        <div class="ana-alan">
            <header class="ust-cubuk d-lg-none d-print-none">
                <button class="menu-ac" type="button" data-bs-toggle="offcanvas" data-bs-target="#kenarCubuk"
                        aria-controls="kenarCubuk" aria-label="Menüyü aç">
                    <i class="bi bi-list" aria-hidden="true"></i>
                </button>
                <a class="marka" asp-controller="Home" asp-action="Index">
                    <span class="marka-logo"><partial name="_Pati" /></span>
                    <span class="marka-ad">Veteriner Kliniği</span>
                </a>
            </header>

            <main id="icerik" class="icerik" tabindex="-1">
                <div class="container-xl">
                    @RenderBody()
                </div>
            </main>

            <footer class="alt-bilgi d-print-none d-lg-none">
                <div class="container-xl">&copy; @DateTime.Now.Year Veteriner Kliniği</div>
            </footer>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
