@model ErrorViewModel
@{
    ViewData["Title"] = "Hata";
}

<h1 class="text-danger">Hata</h1>
<h2 class="text-danger">İsteğiniz işlenirken bir hata oluştu.</h2>

@if (Model.ShowRequestId)
{
    <p>
        <strong>İstek No:</strong> <code>@Model.RequestId</code>
    </p>
}

<p>Lütfen işlemi tekrar deneyin. Sorun devam ederse sistem yöneticisine başvurun.</p>
