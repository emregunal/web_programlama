@model Sahip
@{
    ViewData["Title"] = "Sahip Sil";
    var hayvanSayisi = (int)(ViewData["HayvanSayisi"] ?? 0);
    var odemeSayisi = (int)(ViewData["OdemeSayisi"] ?? 0);
    var silinebilir = hayvanSayisi == 0 && odemeSayisi == 0;
}

<a asp-action="Details" asp-route-id="@Model.Id" class="geri-link"><i class="bi bi-arrow-left" aria-hidden="true"></i> Sahip detayı</a>
<partial name="_Bildirim" />

<div class="card silme-karti">
    <div class="card-body">
        <div class="silme-baslik">
            @if (silinebilir)
            {
                <span class="silme-ikon" aria-hidden="true"><i class="bi bi-trash3"></i></span>
                <div>
                    <h1 class="h3 mb-1">Sahip Sil</h1>
                    <p class="text-secondary mb-0">Bu sahibi silmek istediğinizden emin misiniz? Bu işlem geri alınamaz.</p>
                </div>
            }
            else
            {
                <span class="silme-ikon uyari" aria-hidden="true"><i class="bi bi-exclamation-triangle"></i></span>
                <div>
                    <h1 class="h3 mb-1">Sahip Silinemez</h1>
                    <p class="text-secondary mb-0">Bu sahibe kayıtlı hayvan veya ödeme olduğu için silinemez.</p>
                </div>
            }
        </div>

        <dl class="bilgi-listesi mb-4">
            <div><dt>@Html.DisplayNameFor(m => m.AdSoyad)</dt><dd class="fw-bold">@Model.AdSoyad</dd></div>
            <div><dt>@Html.DisplayNameFor(m => m.Telefon)</dt><dd>@Model.Telefon</dd></div>
            <div><dt>@Html.DisplayNameFor(m => m.Eposta)</dt><dd>@(Model.Eposta ?? "—")</dd></div>
            <div><dt>Hayvan Sayısı</dt><dd>@hayvanSayisi</dd></div>
            <div><dt>Ödeme Sayısı</dt><dd>@odemeSayisi</dd></div>
        </dl>

        @if (silinebilir)
        {
            <form asp-action="Delete" method="post" class="d-flex flex-wrap gap-2">
                <input type="hidden" asp-for="Id" />
                <button type="submit" class="btn btn-danger"><i class="bi bi-trash3" aria-hidden="true"></i> Sahibi Sil</button>
                <a asp-action="Index" class="btn btn-secondary">Vazgeç</a>
            </form>
        }
        else
        {
            <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-secondary">Geri Dön</a>
        }
    </div>
</div>
