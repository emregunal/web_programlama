@model IEnumerable<SahipListeOgesi>
@{
    ViewData["Title"] = "Sahipler";
    var arama = ViewData["Arama"] as string;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="mb-0">Sahipler</h1>
    <a asp-action="Create" class="btn btn-primary">Yeni Sahip</a>
</div>

<partial name="_Bildirim" />

<form method="get" asp-action="Index" class="row g-2 mb-3">
    <div class="col-sm-6 col-md-4">
        <input type="text" name="arama" value="@arama" class="form-control" placeholder="Ad, soyad, telefon veya e-posta ara" />
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-outline-primary">Ara</button>
        <a asp-action="Index" class="btn btn-outline-secondary">Temizle</a>
    </div>
</form>

<table class="table table-striped align-middle">
    <thead>
        <tr>
            <th>Ad Soyad</th>
            <th>Telefon</th>
            <th>E-posta</th>
            <th>Hayvan Sayısı</th>
            <th>Kayıt Tarihi</th>
            <th>İşlemler</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var s in Model)
        {
            <tr>
                <td>@s.AdSoyad</td>
                <td>@s.Telefon</td>
                <td>@s.Eposta</td>
                <td>@s.HayvanSayisi</td>
                <td>@s.KayitTarihi.ToString("dd.MM.yyyy")</td>
                <td>
                    <a asp-action="Details" asp-route-id="@s.Id" class="btn btn-sm btn-outline-info">Detay</a>
                    <a asp-action="Edit" asp-route-id="@s.Id" class="btn btn-sm btn-outline-primary">Düzenle</a>
                    <a asp-action="Delete" asp-route-id="@s.Id" class="btn btn-sm btn-outline-danger">Sil</a>
                </td>
            </tr>
        }
        @if (!Model.Any())
        {
            <tr><td colspan="6" class="text-center text-muted">Kayıt bulunamadı.</td></tr>
        }
    </tbody>
</table>
