@model Sahip
@{
    ViewData["Title"] = Model.AdSoyad;
    var odemeToplami = Model.Odemeler.Sum(o => o.Tutar);
    var muayeneler = Model.Hayvanlar.SelectMany(h => h.Muayeneler).OrderByDescending(m => m.Tarih).ThenByDescending(m => m.Id).ToList();
    var toplamTutar = muayeneler.Sum(m => m.GenelToplam);
    var toplamOdenen = muayeneler.Sum(m => m.OdenenToplam);
    var toplamKalan = muayeneler.Sum(m => m.KalanBorc);
}

<h1>@Model.AdSoyad</h1>
<partial name="_Bildirim" />

<dl class="row">
    <dt class="col-sm-3">@Html.DisplayNameFor(m => m.Telefon)</dt>
    <dd class="col-sm-9">@Model.Telefon</dd>
    <dt class="col-sm-3">@Html.DisplayNameFor(m => m.Eposta)</dt>
    <dd class="col-sm-9">@Model.Eposta</dd>
    <dt class="col-sm-3">@Html.DisplayNameFor(m => m.Adres)</dt>
    <dd class="col-sm-9">@Model.Adres</dd>
    <dt class="col-sm-3">@Html.DisplayNameFor(m => m.KayitTarihi)</dt>
    <dd class="col-sm-9">@Model.KayitTarihi.ToString("dd.MM.yyyy")</dd>
</dl>

<div class="mb-4">
    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">Düzenle</a>
    <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-danger">Sil</a>
    <a asp-action="Index" class="btn btn-secondary">Listeye Dön</a>
</div>

<h2 class="h4">Hayvanlar</h2>
@if (!Model.Hayvanlar.Any())
{
    <p class="text-muted">Kayıtlı hayvan yok.</p>
}
else
{
    <table class="table table-sm">
        <thead>
            <tr><th>Ad</th><th>Tür</th><th>Irk</th><th>Cinsiyet</th></tr>
        </thead>
        <tbody>
            @foreach (var h in Model.Hayvanlar)
            {
                <tr>
                    <td>@h.Ad</td>
                    <td>@h.Tur.GetDisplayName()</td>
                    <td>@h.Irk</td>
                    <td>@h.Cinsiyet.GetDisplayName()</td>
                </tr>
            }
        </tbody>
    </table>
}

<h2 class="h4 mt-4">Muayeneler ve Borç Durumu</h2>
@if (!muayeneler.Any())
{
    <p class="text-muted">Muayene kaydı yok.</p>
}
else
{
    <div class="d-flex gap-4 mb-2">
        <div>Toplam tutar: <strong>@toplamTutar.TL()</strong></div>
        <div>Ödenen: <strong>@toplamOdenen.TL()</strong></div>
        <div class="@(toplamKalan > 0 ? "text-danger" : null)">Kalan borç: <strong>@toplamKalan.TL()</strong></div>
    </div>
    <table class="table table-sm align-middle">
        <thead>
            <tr>
                <th>Tarih</th>
                <th>Hayvan</th>
                <th>Teşhis</th>
                <th class="text-end">Toplam</th>
                <th class="text-end">Ödenen</th>
                <th class="text-end">Kalan</th>
                <th>Durum</th>
                <th>İşlemler</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var m in muayeneler)
            {
                <tr>
                    <td>@m.Tarih.ToString("dd.MM.yyyy HH:mm")</td>
                    <td>@m.Hayvan!.Ad</td>
                    <td>@m.Teshis</td>
                    <td class="text-end">@m.GenelToplam.TL()</td>
                    <td class="text-end">@m.OdenenToplam.TL()</td>
                    <td class="text-end">@m.KalanBorc.TL()</td>
                    <td><partial name="_OdemeDurumuRozeti" model="m.OdemeDurumu" /></td>
                    <td>
                        <a asp-controller="Muayeneler" asp-action="Details" asp-route-id="@m.Id"
                           class="btn btn-sm btn-outline-info">Detay</a>
                        @if (m.KalanBorc > 0)
                        {
                            <a asp-controller="Odemeler" asp-action="Create" asp-route-muayeneId="@m.Id"
                               class="btn btn-sm btn-success">Ödeme Al</a>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

<h2 class="h4 mt-4">Ödemeler</h2>
@if (!Model.Odemeler.Any())
{
    <p class="text-muted">Ödeme kaydı yok.</p>
}
else
{
    <table class="table table-sm">
        <thead>
            <tr>
                <th>Tarih</th>
                <th>Muayene</th>
                <th class="text-end">Tutar</th>
                <th>Yöntem</th>
                <th><span class="visually-hidden">İşlemler</span></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var o in Model.Odemeler)
            {
                <tr>
                    <td>@o.Tarih.ToString("dd.MM.yyyy HH:mm")</td>
                    <td>
                        @if (o.MuayeneId != null)
                        {
                            <a asp-controller="Muayeneler" asp-action="Details" asp-route-id="@o.MuayeneId">#@o.MuayeneId</a>
                        }
                        else
                        {
                            <span>—</span>
                        }
                    </td>
                    <td class="text-end">@o.Tutar.TL()</td>
                    <td>@o.Yontem.GetDisplayName()</td>
                    <td class="text-end">
                        <a asp-controller="Odemeler" asp-action="Details" asp-route-id="@o.Id"
                           class="btn btn-sm btn-outline-secondary">Makbuz</a>
                    </td>
                </tr>
            }
        </tbody>
        <tfoot>
            <tr>
                <th colspan="2">Toplam</th>
                <th class="text-end">@odemeToplami.TL()</th>
                <th colspan="2"></th>
            </tr>
        </tfoot>
    </table>
}
