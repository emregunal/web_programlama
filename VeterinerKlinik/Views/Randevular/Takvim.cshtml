@model IEnumerable<RandevuListeOgesi>
@{
    ViewData["Title"] = "Randevu Takvimi";
    var randevuEkleyebilir = YetkiKurallari.IzinVarMi(User, "Randevular", "Create");
    var pazartesi = (DateTime)ViewData["HaftaBasi"]!;
    var cumartesi = pazartesi.AddDays(5);
    var veterinerler = (SelectList)ViewData["Veterinerler"]!;
    var veterinerId = ViewData["VeterinerId"] as int?;
    var bugun = DateTime.Today;
    var haftaMetni = pazartesi.ToString("yyyy-MM-dd");
    var oncekiHafta = pazartesi.AddDays(-7).ToString("yyyy-MM-dd");
    var sonrakiHafta = pazartesi.AddDays(7).ToString("yyyy-MM-dd");
    var buHafta = DateTime.Today.ToString("yyyy-MM-dd");
    string aralik;
    if (pazartesi.Year != cumartesi.Year)
        aralik = $"{pazartesi:d MMMM yyyy} – {cumartesi:d MMMM yyyy}";
    else if (pazartesi.Month != cumartesi.Month)
        aralik = $"{pazartesi:d MMMM} – {cumartesi:d MMMM yyyy}";
    else
        aralik = $"{pazartesi.Day}–{cumartesi:d MMMM yyyy}";
}

<div class="sayfa-baslik">
    <div>
        <h1>Randevu Takvimi</h1>
        <p class="sayfa-aciklama">@aralik</p>
    </div>
    <div class="sayfa-eylemler">
        <div class="btn-group" role="group" aria-label="Görünüm">
            <a asp-action="Index" class="btn btn-outline-primary"><i class="bi bi-list-ul" aria-hidden="true"></i> Liste</a>
            <a asp-action="Takvim" class="btn btn-primary active" aria-current="true">
                <i class="bi bi-calendar3-week" aria-hidden="true"></i> Takvim
            </a>
        </div>
        @if (randevuEkleyebilir)
        {
            <a asp-action="Create" class="btn btn-primary">
                <i class="bi bi-plus-lg" aria-hidden="true"></i> Yeni Randevu
            </a>
        }
    </div>
</div>

<partial name="_Bildirim" />

<div class="filtre row g-2 align-items-end">
    <div class="col-12 col-md d-flex flex-wrap gap-2">
        <a asp-action="Takvim" asp-route-hafta="@oncekiHafta" asp-route-veterinerId="@veterinerId"
           class="btn btn-outline-secondary">‹ Önceki hafta</a>
        <a asp-action="Takvim" asp-route-hafta="@buHafta" asp-route-veterinerId="@veterinerId"
           class="btn btn-outline-secondary">Bu hafta</a>
        <a asp-action="Takvim" asp-route-hafta="@sonrakiHafta" asp-route-veterinerId="@veterinerId"
           class="btn btn-outline-secondary">Sonraki hafta ›</a>
    </div>
    <form method="get" asp-action="Takvim" class="col-12 col-md-auto d-flex gap-2 align-items-end">
        <input type="hidden" name="hafta" value="@haftaMetni" />
        <div>
            <label for="filtreVeteriner" class="form-label">Veteriner</label>
            <select id="filtreVeteriner" name="veterinerId" asp-items="veterinerler" class="form-select">
                <option value="">Tümü</option>
            </select>
        </div>
        <button type="submit" class="btn btn-outline-primary"><i class="bi bi-funnel" aria-hidden="true"></i> Filtrele</button>
    </form>
</div>

<div class="takvim">
    @for (var i = 0; i < 6; i++)
    {
        var gun = pazartesi.AddDays(i);
        var gunRandevulari = Model.Where(r => r.Baslangic.Date == gun).ToList();
        var ekleBaslangic = gun.AddHours(9).ToString("yyyy-MM-ddTHH:mm");
        var gunSinifi = "takvim-gun";
        if (gun == bugun)
            gunSinifi += " bugun";
        var gunBasligi = gun.ToString("d MMMM dddd");
        var gunKisa = gun.ToString("d MMMM");
        <section class="@gunSinifi" aria-label="@gunBasligi">
            <div class="takvim-gun-baslik">
                <span>@gun.ToString("dddd")</span>
                <span class="takvim-gun-tarih">@gunKisa</span>
            </div>
            @foreach (var r in gunRandevulari)
            {
                var sinif = r.Durum switch
                {
                    RandevuDurumu.Tamamlandi => "tamamlandi",
                    RandevuDurumu.IptalEdildi => "iptal",
                    RandevuDurumu.Gelmedi => "gelmedi",
                    _ => "planlandi"
                };
                var parcalar = r.VeterinerAdSoyad.Split(' ', StringSplitOptions.RemoveEmptyEntries);
                var kisaVeteriner = r.VeterinerAdSoyad;
                if (parcalar.Length > 1)
                    kisaVeteriner = $"{parcalar[0][0]}. {parcalar[^1]}";
                <a asp-action="Details" asp-route-id="@r.Id" class="takvim-randevu @sinif" title="@r.Durum.GetDisplayName()">
                    <span class="takvim-randevu-saat">@($"{r.Baslangic:HH:mm}–{r.Bitis:HH:mm}")</span>
                    <span class="takvim-randevu-hayvan">@r.HayvanAdi</span>
                    <span class="takvim-randevu-alt">@r.SahipAdSoyad</span>
                    <span class="takvim-randevu-alt">@kisaVeteriner</span>
                </a>
            }
            @if (gunRandevulari.Count == 0)
            {
                <div class="takvim-bos">Randevu yok</div>
            }
            @if (randevuEkleyebilir)
            {
                <a asp-action="Create" asp-route-baslangic="@ekleBaslangic" asp-route-veterinerId="@veterinerId" class="takvim-ekle"
                   title="@gunKisa için randevu ekle" aria-label="@gunBasligi için randevu ekle">
                    <i class="bi bi-plus-lg" aria-hidden="true"></i>
                </a>
            }
        </section>
    }
</div>
