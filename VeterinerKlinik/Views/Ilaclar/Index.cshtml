@model IEnumerable<IlacListeOgesi>
@{
    ViewData["Title"] = "İlaçlar";
    var arama = ViewData["Arama"] as string;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="mb-0">İlaçlar</h1>
    <a asp-action="Create" class="btn btn-primary">Yeni İlaç</a>
</div>

<partial name="_Bildirim" />

<form method="get" asp-action="Index" class="row g-2 mb-3">
    <div class="col-sm-6 col-md-4">
        <input type="text" name="arama" value="@arama" class="form-control" placeholder="İlaç adı veya form ara" />
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-outline-primary">Ara</button>
        <a asp-action="Index" class="btn btn-outline-secondary">Temizle</a>
    </div>
</form>

<table class="table table-striped align-middle">
    <thead>
        <tr>
            <th>İlaç Adı</th>
            <th>Form</th>
            <th>Birim</th>
            <th class="text-end">Birim Fiyat</th>
            <th>Reçete Sayısı</th>
            <th>İşlemler</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var i in Model)
        {
            <tr>
                <td>@i.Ad</td>
                <td>@i.Form</td>
                <td>@i.Birim</td>
                <td class="text-end">@i.BirimFiyat.TL()</td>
                <td>@i.KullanimSayisi</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@i.Id" class="btn btn-sm btn-outline-primary">Düzenle</a>
                    <a asp-action="Delete" asp-route-id="@i.Id" class="btn btn-sm btn-outline-danger">Sil</a>
                </td>
            </tr>
        }
        @if (!Model.Any())
        {
            <tr><td colspan="6" class="text-center text-muted">Kayıt bulunamadı.</td></tr>
        }
    </tbody>
</table>
