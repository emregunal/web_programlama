@model IEnumerable<IlacListeOgesi>
@{
    ViewData["Title"] = "İlaçlar";
    var kayitYonetebilir = YetkiKurallari.IzinVarMi(User, "Ilaclar", "Create");
    var arama = ViewData["Arama"] as string;
}

<div class="sayfa-baslik">
    <div>
        <h1>İlaçlar</h1>
        <p class="sayfa-aciklama">Reçetelerde kullanılan ilaç kataloğu ve birim fiyatlar.</p>
    </div>
    @if (kayitYonetebilir)
    {
        <div class="sayfa-eylemler">
            <a asp-action="Create" class="btn btn-primary">
                <i class="bi bi-plus-lg" aria-hidden="true"></i> Yeni İlaç
            </a>
        </div>
    }
</div>

<partial name="_Bildirim" />

<form method="get" asp-action="Index" class="filtre row g-2 align-items-center" role="search">
    <div class="col-sm-8 col-md-6">
        <div class="arama-kutusu">
            <i class="bi bi-search" aria-hidden="true"></i>
            <input type="search" name="arama" value="@arama" class="form-control" aria-label="İlaç ara"
                   placeholder="İlaç adı veya form ara" />
        </div>
    </div>
    <div class="col-auto d-flex gap-2">
        <button type="submit" class="btn btn-outline-primary">Ara</button>
        @if (!string.IsNullOrEmpty(arama))
        {
            <a asp-action="Index" class="btn btn-outline-secondary">Temizle</a>
        }
    </div>
</form>

<div class="tablo-kart">
    <table class="table align-middle">
        <thead>
            <tr>
                <th scope="col">İlaç Adı</th>
                <th scope="col">Form</th>
                <th scope="col">Birim</th>
                <th scope="col" class="text-end">Birim Fiyat</th>
                <th scope="col" class="text-center">Reçete Sayısı</th>
                <th scope="col" class="text-end"><span class="visually-hidden">İşlemler</span></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var i in Model)
            {
                <tr>
                    <td class="hucre-ana">@i.Ad</td>
                    <td>@i.Form</td>
                    <td>@i.Birim</td>
                    <td class="text-end tutar">@i.BirimFiyat.TL()</td>
                    <td class="text-center">@i.KullanimSayisi</td>
                    <td>
                        <div class="islemler">
                            @if (kayitYonetebilir)
                            {
                                <a asp-action="Edit" asp-route-id="@i.Id" class="btn btn-ikon" title="Düzenle" aria-label="@i.Ad düzenle"><i class="bi bi-pencil-square" aria-hidden="true"></i></a>
                                <a asp-action="Delete" asp-route-id="@i.Id" class="btn btn-ikon tehlike" title="Sil" aria-label="@i.Ad sil"><i class="bi bi-trash3" aria-hidden="true"></i></a>
                            }
                        </div>
                    </td>
                </tr>
            }
            @if (!Model.Any())
            {
                <tr>
                    <td colspan="6">
                        <div class="bos-durum">
                            <span class="bos-durum-ikon" aria-hidden="true"><i class="bi bi-capsule"></i></span>
                            @if (!string.IsNullOrEmpty(arama))
                            {
                                <div class="bos-durum-baslik">Aramanızla eşleşen ilaç bulunamadı.</div>
                                <p>Farklı bir ilaç adı veya form ile tekrar deneyin.</p>
                                <a asp-action="Index" class="btn btn-outline-secondary btn-sm">Aramayı temizle</a>
                            }
                            else
                            {
                                <div class="bos-durum-baslik">Henüz ilaç tanımlanmadı.</div>
                                @if (kayitYonetebilir)
                                {
                                    <p>Reçete yazabilmek için önce ilaç ekleyin.</p>
                                    <a asp-action="Create" class="btn btn-primary btn-sm"><i class="bi bi-plus-lg" aria-hidden="true"></i> Yeni İlaç</a>
                                }
                            }
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
